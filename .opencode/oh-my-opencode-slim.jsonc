{
  // oh-my-opencode-slim — project-scoped config for ShettyXtreme
  // Docs: https://github.com/alvinunreal/oh-my-opencode-slim/blob/master/docs/configuration.md
  // All models run on opencode-go via headroom (token savings preserved).
  // NEVER use gpt-5.6-luna: its streams break through headroom (headroom issue #1944).
  "preset": "shettyxtreme",
  "autoUpdate": false,
  "disabled_agents": ["observer"],
  "presets": {
    "shettyxtreme": {
      "orchestrator": { "model": "opencode-go/qwen3.7-plus", "mcps": ["*", "!context7", "!gh_grep"], "skills": ["*"] },
      "explorer":     { "model": "opencode-go/deepseek-v4-flash", "mcps": ["codegraph", "graphify", "headroom"], "skills": [], "permission": { "edit": "deny" } },
      "oracle":       { "model": "opencode-go/deepseek-v4-pro", "mcps": ["open-second-brain", "codegraph", "graphify", "headroom"], "skills": ["simplify", "code-review", "diagnosing-bugs", "verification-planning", "systematic-debugging"], "permission": { "edit": "deny" } },
      "librarian":    { "model": "opencode-go/minimax-m2.7", "mcps": ["context7", "gh_grep", "codegraph", "graphify", "headroom"], "skills": ["research"] },
      "designer":     { "model": "opencode-go/kimi-k2.7-code", "mcps": ["codegraph", "graphify", "headroom"], "skills": ["design-taste-frontend", "ui-ux-pro-max", "design-system"] },
      "fixer":        { "model": "opencode-go/mimo-v2.5-pro", "mcps": ["codegraph", "graphify", "serena", "headroom"], "skills": ["tdd", "verification-before-completion", "verification-planning", "simplify"] },
      "council":      { "model": "opencode-go/qwen3.7-plus", "mcps": ["codegraph", "headroom"], "skills": [] }
    }
  },
  "council": {
    "default_preset": "shettyxtreme",
    "presets": {
      "shettyxtreme": {
      "alpha": { "model": "opencode-go/deepseek-v4-flash", "mcps": ["codegraph", "headroom"] },
      "beta":  { "model": "opencode-go/qwen3.7-plus", "mcps": ["codegraph", "headroom"] },
      "gamma": { "model": "opencode-go/mimo-v2.5", "mcps": ["codegraph", "headroom"] }
      }
    }
  }
}
